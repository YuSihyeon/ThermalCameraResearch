<?xml version="1.0"?>
<package format="3">
  <name>firesight_calib</name>
  <version>0.3.0</version>
  <description>Boson thermal intrinsic calibration with USB and ROS 2 image capture.</description>
  <maintainer email="dev@haechiar.local">HaechiAR</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>python3-numpy</exec_depend>
